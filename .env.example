# Continuous profiling is deliberately opt-in.
PYROSCOPE_ENABLED=false

# Required when enabled. Use an internal service or authenticated reverse proxy.
PYROSCOPE_SERVER_ADDRESS=
PYROSCOPE_ALLOW_INSECURE_HTTP=false
PYROSCOPE_APPLICATION_NAME=

# Optional low-cardinality labels: key=value,key2=value2
PYROSCOPE_TAGS=
PYROSCOPE_TENANT_ID=

# Optional HTTP Basic authentication. Prefer a mounted Secret file; configure
# either PASSWORD or PASSWORD_FILE, never both. Do not commit a real password.
PYROSCOPE_BASIC_AUTH_USER=
PYROSCOPE_BASIC_AUTH_PASSWORD=
PYROSCOPE_BASIC_AUTH_PASSWORD_FILE=

# Safe operational defaults.
PYROSCOPE_LOGGING=false
PYROSCOPE_DISABLE_GC_RUNS=true
PYROSCOPE_UPLOAD_RATE=15s
PYROSCOPE_HTTP_TIMEOUT=5s

# Default profile set balances diagnostic value and application overhead.
PYROSCOPE_PROFILE_CPU=true
PYROSCOPE_PROFILE_ALLOC_OBJECTS=false
PYROSCOPE_PROFILE_ALLOC_SPACE=true
PYROSCOPE_PROFILE_INUSE_OBJECTS=false
PYROSCOPE_PROFILE_INUSE_SPACE=true
PYROSCOPE_PROFILE_GOROUTINES=true

# Enable these only for a targeted contention investigation.
PYROSCOPE_PROFILE_MUTEX=false
PYROSCOPE_MUTEX_PROFILE_FRACTION=5
PYROSCOPE_PROFILE_BLOCK=false
PYROSCOPE_BLOCK_PROFILE_RATE=5
