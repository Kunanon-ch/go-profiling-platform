FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -tags=smoke -ldflags="-s -w" -o /out/pyroscope-smoke ./cmd/pyroscope-smoke

FROM scratch
COPY --from=builder --chown=65532:65532 /out/pyroscope-smoke /pyroscope-smoke
USER 65532:65532
ENTRYPOINT ["/pyroscope-smoke"]
